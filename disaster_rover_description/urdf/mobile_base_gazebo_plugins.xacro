<!-- ================================================= -->
<!-- LEFT FINGER CONTROLLER -->
<!-- ================================================= -->

<gazebo>
  <plugin
    filename="gz-sim-joint-position-controller-system"
    name="left_finger_controller">

    <joint_name>left_finger_joint</joint_name>

    <topic>/model/disaster_rover/joint/left_finger_joint/0/cmd_pos</topic>

    <p_gain>50</p_gain>
    <i_gain>0.01</i_gain>
    <d_gain>5</d_gain>

    <cmd_max>0.4</cmd_max>
    <cmd_min>-0.4</cmd_min>

  </plugin>
</gazebo>

<!-- ================================================= -->
<!-- RIGHT FINGER CONTROLLER -->
<!-- ================================================= -->

<gazebo>
  <plugin
    filename="gz-sim-joint-position-controller-system"
    name="right_finger_controller">

    <joint_name>right_finger_joint</joint_name>

    <topic>/model/disaster_rover/joint/right_finger_joint/0/cmd_pos</topic>

    <p_gain>50</p_gain>
    <i_gain>0.01</i_gain>
    <d_gain>5</d_gain>

    <cmd_max>0.4</cmd_max>
    <cmd_min>-0.4</cmd_min>

  </plugin>
</gazebo>
  <!-- ================================================= -->
  <!-- ODOMETRY -->
  <!-- ================================================= -->
<!-- 
