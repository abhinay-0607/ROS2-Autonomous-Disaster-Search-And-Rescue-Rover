  <!-- ================================================= -->
  <!-- STRUCTURAL DEBRIS SLABS                           -->
  <!-- ================================================= -->
  <model name="debris_slab_1"><static>true</static><pose>-5 10 0.25 0.3 0.1 0.6</pose>
    <link name="link"><collision name="c"><geometry><box><size>3.5 2.0 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3.5 2.0 0.3</size></box></geometry>
