  </gazebo> -->

  <!-- ================================================= -->
  <!-- SCENE BROADCASTER -->
  <!-- ================================================= -->

  <gazebo>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>
  </gazebo>

  <!-- ================================================= -->
  <!-- USER COMMANDS -->
  <!-- ================================================= -->

 <gazebo>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">

      <joint_name>arm_base_joint</joint_name>

      <topic>/model/disaster_rover/joint/arm_base_joint/0/cmd_pos</topic>

      <p_gain>100</p_gain>
      <i_gain>0.01</i_gain>
      <d_gain>10</d_gain>

      <cmd_max>500</cmd_max>
      <cmd_min>-500</cmd_min>

    </plugin>
  </gazebo>

  <!-- SHOULDER -->

  <gazebo>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">

      <joint_name>shoulder_joint</joint_name>

      <topic>/model/disaster_rover/joint/shoulder_joint/0/cmd_pos</topic>

      <p_gain>100</p_gain>
      <i_gain>0.01</i_gain>
      <d_gain>10</d_gain>

      <cmd_max>500</cmd_max>
      <cmd_min>-500</cmd_min>

    </plugin>
  </gazebo>

  <!-- ELBOW -->

  <gazebo>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">

      <joint_name>elbow_joint</joint_name>

      <topic>/model/disaster_rover/joint/elbow_joint/0/cmd_pos</topic>

      <p_gain>100</p_gain>
      <i_gain>0.01</i_gain>
      <d_gain>10</d_gain>

      <cmd_max>500</cmd_max>
      <cmd_min>-500</cmd_min>

    </plugin>
  </gazebo>

  <!-- WRIST -->

  <gazebo>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">

      <joint_name>wrist_joint</joint_name>

      <topic>/model/disaster_rover/joint/wrist_joint/0/cmd_pos</topic>

      <p_gain>100</p_gain>
      <i_gain>0.01</i_gain>
      <d_gain>10</d_gain>

      <cmd_max>500</cmd_max>
      <cmd_min>-500</cmd_min>

    </plugin>
  </gazebo>


  <gazebo>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
  </gazebo>

</robot>




 