      <visual name="v"><geometry><box><size>4.0 1.8 0.3</size></box></geometry>
        <material><ambient>0.52 0.50 0.47 1</ambient><diffuse>0.57 0.55 0.52 1</diffuse></material></visual></link>
  </model>
  <model name="debris_chunk_1"><static>true</static><pose>-10 14 0.5 0.5 0.2 0.3</pose>
    <link name="link"><collision name="c"><geometry><box><size>1.8 1.4 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.8 1.4 1.0</size></box></geometry>
        <material><ambient>0.53 0.51 0.48 1</ambient><diffuse>0.58 0.56 0.53 1</diffuse></material></visual></link>
