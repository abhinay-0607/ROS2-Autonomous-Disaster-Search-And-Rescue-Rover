<launch>

    
    <!-- PATHS -->
    

    <let name="urdf_path"
         value="$(find-pkg-share disaster_rover_description)/urdf/rover.urdf.xacro" />

    <let name="world_path"
         value="$(find-pkg-share disaster_rover_description)/worlds/testworld1.sdf" />

    <let name="bridge_config"
         value="$(find-pkg-share disaster_rover_bringup)/config/ros_gz_bridge.yaml" />

    <!-- ROBOT STATE PUBLISHER -->


    <node
        pkg="robot_state_publisher"
        exec="robot_state_publisher"
        output="screen">

        <param
            name="robot_description"
            value="$(command 'xacro $(var urdf_path)')" />

        <param
            name="use_sim_time"
            value="true" />

    </node>


    <!-- GAZEBO -->
    

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">

        <arg
            name="gz_args"
            value="$(var world_path) -r" />

    </include>

    
    <!-- SPAWN ROBOT -->


    <node
        pkg="ros_gz_sim"
        exec="create"
        output="screen"

        args="-topic robot_description
              -name disaster_rover
              -x 0
              -y 0
              -z 0.5"

        respawn="true"
        respawn_delay="2.0">

        <param
            name="use_sim_time"
            value="true" />

    </node>

    
    <!-- ROS_GZ BRIDGE -->


    <node
        pkg="ros_gz_bridge"
        exec="parameter_bridge"
        output="screen">

        <param
            name="config_file"
            value="$(var bridge_config)" />

        <param
            name="use_sim_time"
            value="true" />

    </node>

    
    <!-- RVIZ -->
    

    <node
        pkg="rviz2"
        exec="rviz2"
        output="screen">

        <param
            name="use_sim_time"
            value="true" />

    </node>

</launch>