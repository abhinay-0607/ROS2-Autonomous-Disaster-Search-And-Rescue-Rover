<?xml version="1.0"?>

<robot name="disaster_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  
  <!-- PROPERTIES -->
  

  <xacro:property name="base_length" value="0.7"/>
  <xacro:property name="base_width"  value="0.5"/>
  <xacro:property name="base_height" value="0.15"/>

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width"  value="0.05"/>

  <xacro:include filename="mobile_base_gazebo_plugins.xacro"/>


  <!-- MATERIALS -->
  

  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>


  <!-- INERTIA MACROS -->
  

  <xacro:macro name="box_inertia" params="m x y z">

    <inertial>

      <mass value="${m}"/>

      <inertia
        ixx="${(m/12)*(y*y+z*z)}"
        ixy="0"
        ixz="0"
        iyy="${(m/12)*(x*x+z*z)}"
        iyz="0"
        izz="${(m/12)*(x*x+y*y)}"/>

    </inertial>

  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l">

    <inertial>

      <mass value="${m}"/>

      <inertia
        ixx="${(m/12)*(3*r*r+l*l)}"
        ixy="0"
        ixz="0"
        iyy="${(m/12)*(3*r*r+l*l)}"
        iyz="0"
        izz="${0.5*m*r*r}"/>

    </inertial>

  </xacro:macro>

  
  <!-- BASE -->

  <link name="base_footprint"/>

  <link name="base_link">

    <visual>

      <origin xyz="0 0 ${base_height/2}"/>

      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>

      <material name="blue"/>

    </visual>

    <collision name="base_link_collision">

      <origin xyz="0 0 ${base_height/2}"/>

      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>

    </collision>

    <xacro:box_inertia
      m="12"
      x="${base_length}"
      y="${base_width}"
      z="${base_height}"/>

  </link>

  <joint name="base_joint" type="fixed">

    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin xyz="0 0 ${wheel_radius}"/>

  </joint>


  <!-- WHEEL MACRO -->
 

  <xacro:macro name="wheel" params="name x y">

    <link name="${name}_link">

      <visual>

        <origin xyz="0 0 0" rpy="1.5708 0 0"/>

        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>

        <material name="black"/>

      </visual>

      <collision>

        <origin xyz="0 0 0" rpy="1.5708 0 0"/>

        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>

      </collision>

      <xacro:cylinder_inertia
        m="1"
        r="${wheel_radius}"
        l="${wheel_width}"/>

    </link>

    <joint name="${name}_joint" type="continuous">

      <parent link="base_link"/>
      <child link="${name}_link"/>

      <origin xyz="${x} ${y} 0"/>

      <axis xyz="0 1 0"/>

    </joint>

  </xacro:macro>

 
  <!-- WHEELS -->


  <xacro:wheel name="front_left_wheel"  x="0.25"  y="0.30"/>
  <xacro:wheel name="front_right_wheel" x="0.25"  y="-0.30"/>
  <xacro:wheel name="rear_left_wheel"   x="-0.25" y="0.30"/>
  <xacro:wheel name="rear_right_wheel"  x="-0.25" y="-0.30"/>


<!-- CAMERA LINK -->


<link name="camera_link">

  <visual>

    <geometry>
      <box size="0.06 0.04 0.04"/>
    </geometry>

    <material name="grey"/>

  </visual>

  <collision>

    <geometry>
      <box size="0.06 0.04 0.04"/>
    </geometry>

  </collision>

  <inertial>

    <mass value="0.2"/>

    <inertia
      ixx="0.0001"
      ixy="0.0"
      ixz="0.0"
      iyy="0.0001"
      iyz="0.0"
      izz="0.0001"/>

  </inertial>

</link>

<joint name="camera_joint" type="fixed">

  <parent link="base_link"/>
  <child link="camera_link"/>

  <origin xyz="0.32 0 0.18"/>

</joint>


<!-- CAMERA SENSOR -->


<gazebo reference="camera_link">

  <sensor name="camera_sensor" type="camera">

    <always_on>true</always_on>

    <update_rate>30</update_rate>

    <visualize>true</visualize>

    <topic>/camera</topic>

    <camera>

      <horizontal_fov>1.3962634</horizontal_fov>

      <image>

        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>

      </image>

      <clip>

        <near>0.1</near>
        <far>100</far>

      </clip>

    </camera>

  </sensor>

</gazebo>


  <!-- LIDAR POLE -->


  <link name="lidar_pole_link">

    <visual>

      <origin xyz="0 0 0.12"/>

      <geometry>
        <cylinder radius="0.02" length="0.24"/>
      </geometry>

      <material name="grey"/>

    </visual>

    <collision>

      <origin xyz="0 0 0.12"/>

      <geometry>
        <cylinder radius="0.02" length="0.24"/>
      </geometry>

    </collision>

    <xacro:cylinder_inertia
      m="0.2"
      r="0.02"
      l="0.24"/>

  </link>

  <joint name="lidar_pole_joint" type="fixed">

    <parent link="base_link"/>
    <child link="lidar_pole_link"/>

    <origin xyz="0 0 0.15"/>

  </joint>

  <!-- LIDAR -->


  <link name="lidar_link">

    <visual>

      <geometry>
        <cylinder radius="0.08" length="0.08"/>
      </geometry>

      <material name="black"/>

    </visual>

    <collision>

      <geometry>
        <cylinder radius="0.08" length="0.08"/>
      </geometry>

    </collision>

    <xacro:cylinder_inertia
      m="0.3"
      r="0.08"
      l="0.08"/>

  </link>

  <joint name="lidar_joint" type="fixed">

    <parent link="lidar_pole_link"/>
    <child link="lidar_link"/>

    <origin xyz="0 0 0.24"/>

  </joint>

  <!-- ARM BASE -->


  <link name="arm_base_link">

    <visual>

      <origin xyz="0 0 0.04"/>

      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>

      <material name="grey"/>

    </visual>

    <collision>

      <origin xyz="0 0 0.04"/>

      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>

    </collision>

    <xacro:cylinder_inertia
      m="1.0"
      r="0.05"
      l="0.08"/>

  </link>

  <gazebo reference="arm_base_link">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
    <collide_without_contact>true</collide_without_contact>
  </gazebo>

  <joint name="arm_base_joint" type="revolute">

    <parent link="base_link"/>
    <child link="arm_base_link"/>

    <origin xyz="-0.20 0 0.18"/>

    <axis xyz="0 0 1"/>

    <limit lower="-3.14"
           upper="3.14"
           effort="100"
           velocity="2"/>

    <dynamics damping="10.0" friction="5.0"/>

  </joint>


  <!-- UPPER ARM -->


  <link name="upper_arm_link">

    <visual>

      <origin xyz="0 0 0.15"/>

      <geometry>
        <box size="0.06 0.06 0.30"/>
      </geometry>

      <material name="blue"/>

    </visual>

    <collision>

      <origin xyz="0 0 0.15"/>

      <geometry>
        <box size="0.06 0.06 0.30"/>
      </geometry>

    </collision>

    <xacro:box_inertia
      m="1.5"
      x="0.06"
      y="0.06"
      z="0.30"/>

  </link>

  <gazebo reference="upper_arm_link">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
    <collide_without_contact>true</collide_without_contact>
  </gazebo>

  <joint name="shoulder_joint" type="revolute">

    <parent link="arm_base_link"/>
    <child link="upper_arm_link"/>

    <origin xyz="0 0 0.04"/>

    <axis xyz="1 0 0"/>

    <limit lower="-1.57"
           upper="1.57"
           effort="100"
           velocity="2"/>

    <dynamics damping="10.0" friction="5.0"/>

  </joint>

  <!-- FOREARM -->
  

  <link name="forearm_link">

    <visual>

      <origin xyz="0 0 0.125"/>

      <geometry>
        <box size="0.05 0.05 0.25"/>
      </geometry>

      <material name="grey"/>

    </visual>

    <collision>

      <origin xyz="0 0 0.125"/>

      <geometry>
        <box size="0.05 0.05 0.25"/>
      </geometry>

    </collision>

    <xacro:box_inertia
      m="1.2"
      x="0.05"
      y="0.05"
      z="0.25"/>

  </link>

  <gazebo reference="forearm_link">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
    <collide_without_contact>true</collide_without_contact>
  </gazebo>

  <joint name="elbow_joint" type="revolute">

    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>

    <origin xyz="0 0 0.26"/>

    <axis xyz="1 0 0"/>

    <limit lower="-1.57"
           upper="1.57"
           effort="80"
           velocity="2"/>

    <dynamics damping="10.0" friction="5.0"/>

  </joint>

  <!-- WRIST -->

  <link name="gripper_base_link">

    <visual>

      <origin xyz="0 0 0.03"/>

      <geometry>
        <box size="0.08 0.08 0.06"/>
      </geometry>

      <material name="black"/>

    </visual>

    <collision>

      <origin xyz="0 0 0.03"/>

      <geometry>
        <box size="0.08 0.08 0.06"/>
      </geometry>

    </collision>

    <xacro:box_inertia
      m="0.5"
      x="0.08"
      y="0.08"
      z="0.06"/>

  </link>

  <gazebo reference="gripper_base_link">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
    <collide_without_contact>true</collide_without_contact>
  </gazebo>

  <joint name="wrist_joint" type="revolute">

    <parent link="forearm_link"/>
    <child link="gripper_base_link"/>

    <origin xyz="0 0 0.22"/>

    <axis xyz="1 0 0"/>

    <limit lower="-1.57"
           upper="1.57"
           effort="50"
           velocity="2"/>

    <dynamics damping="10.0" friction="5.0"/>

  </joint>

    
  <!-- LEFT FINGER -->


  <link name="left_finger_link">

    <visual>

      <origin xyz="0 0.045 0.05"/>

      <geometry>
        <box size="0.02 0.02 0.10"/>
      </geometry>

      <material name="grey"/>

    </visual>
<!-- 
    <collision>

      <origin xyz="0 0.045 0.05"/>

      <geometry>
        <box size="0.02 0.02 0.10"/>
      </geometry>

    </collision> -->

    <xacro:box_inertia
      m="0.1"
      x="0.02"
      y="0.02"
      z="0.10"/>

  </link>

  <gazebo reference="left_finger_link">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
  </gazebo>

  <joint name="left_finger_joint" type="prismatic">

    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>

    <origin xyz="0 0.03 0"/>

    <axis xyz="0 0 1"/>

    <limit lower="-0.4"
           upper="0.4"
           effort="20"
           velocity="2"/>

    <dynamics damping="2.0" friction="1.0"/>

  </joint>

  <!-- RIGHT FINGER -->

  <link name="right_finger_link">

    <visual>

      <origin xyz="0 -0.045 0.05"/>

      <geometry>
        <box size="0.02 0.02 0.10"/>
      </geometry>

      <material name="grey"/>

    </visual>

    <!-- <collision>

      <origin xyz="0 -0.045 0.05"/>

      <geometry>
        <box size="0.02 0.02 0.10"/>
      </geometry>

    </collision> -->

    <xacro:box_inertia
      m="0.1"
      x="0.02"
      y="0.02"
      z="0.10"/>

  </link>

  <gazebo reference="right_finger_link">
    <gravity>false</gravity>
    <selfCollide>false</selfCollide>
  </gazebo>

  <joint name="right_finger_joint" type="prismatic">

    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>

    <origin xyz="0 -0.03 0"/>

    <axis xyz="0 0 -1"/>

    <limit lower="-0.4"
           upper="0.4"
           effort="20"
           velocity="2"/>

    <dynamics damping="2.0" friction="1.0"/>

  </joint>


  <!-- IMU -->


  <gazebo reference="base_link">

    <sensor name="imu_sensor" type="imu">

      <always_on>true</always_on>

      <update_rate>100</update_rate>

      <visualize>true</visualize>

    </sensor>

  </gazebo>

  <!-- LIDAR SENSOR -->


  <gazebo reference="lidar_link">

    
      <sensor name="lidar_sensor" type="gpu_lidar">

      <topic>/scan</topic>

      <always_on>true</always_on>
      <visualize>true</visualize>
      <frame_id>lidar_link</frame_id>
      <gz_frame_id>lidar_link</gz_frame_id> 
      <update_rate>30</update_rate>

      <ray>

        <scan>

          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>

          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>

        </scan>

        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>

      </ray>

    </sensor>

  </gazebo>

</robot>