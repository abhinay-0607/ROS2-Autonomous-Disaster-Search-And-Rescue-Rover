    </link>
  </model>

  <!-- === MEDIUM ROCKS === -->

  <model name="rock_med_A"><static>true</static><pose>-9 2 0 0.3 0.2 0.6</pose>
    <link name="link"><pose>0 0 0.38 0 0 0</pose>
