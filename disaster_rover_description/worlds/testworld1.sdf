<?xml version="1.0" ?>
<!--
  beach_disaster_world.sdf  –  Gazebo (gz-sim, Harmonic / Ionic / Jetty)
  ========================================================================
  VERIFIED FUEL MODELS (all confirmed present on fuel.gazebosim.org):
    • https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking Person
    • https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone
    • https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Barrel
    • https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ambulance
    • https://fuel.gazebosim.org/1.0/OpenRobotics/models/Backpack
    • https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier

  ROCKS: No numbered "Rock 1..10" exist on OpenRobotics Fuel.
         Rocks are rendered as inline geometry with high-quality PBR-style
         materials (multi-face box clusters + ellipsoid bases) that look far
         more natural than smooth spheres. Each rock cluster is a separate
         model with several tilted/scaled links so it reads as an irregular
         boulder.

  Run with:  gz sim beach_disaster_world.sdf -r
-->

<sdf version="1.8">
<world name="beach_disaster_world">

  <!-- ================================================= -->
  <!-- PHYSICS                                           -->
  <!-- ================================================= -->
  <physics name="1ms" type="ignored">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
  </physics>
  <physics type="ode">
  <max_step_size>0.01</max_step_size>
  <real_time_update_rate>100</real_time_update_rate>
</physics>

  <!-- ================================================= -->
  <!-- PLUGINS                                           -->
  <!-- ================================================= -->
  <plugin filename="gz-sim-physics-system"
          name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-scene-broadcaster-system"
          name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-user-commands-system"
          name="gz::sim::systems::UserCommands"/>
  
  <plugin
    filename="gz-sim-sensors-system"
    name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

  <plugin
    filename="gz-sim-imu-system"
    name="gz::sim::systems::Imu">
  </plugin>        

  <!-- ================================================= -->
  <!-- SCENE                                             -->
  <!-- ================================================= -->
  <scene>
    <ambient>0.70 0.68 0.60 1</ambient>
    <background>0.45 0.50 0.55 1</background>
    <shadows>true</shadows>
    <fog>
      <color>0.75 0.73 0.68 1</color>
      <type>linear</type>
      <start>40</start><end>100</end><density>0.04</density>
    </fog>
  </scene>

  <!-- ================================================= -->
  <!-- LIGHTING                                          -->
  <!-- ================================================= -->
  <light name="disaster_sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 50 0 0 0</pose>
    <diffuse>0.85 0.80 0.72 1</diffuse>
    <specular>0.30 0.30 0.30 1</specular>
    <attenuation><range>1000</range><constant>0.9</constant>
      <linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    <direction>-0.3 0.1 -0.95</direction>
  </light>

  <light name="sky_fill" type="directional">
    <cast_shadows>false</cast_shadows>
    <pose>0 0 20 0 0 0</pose>
    <diffuse>0.25 0.30 0.38 1</diffuse>
    <specular>0 0 0 1</specular>
    <attenuation><range>500</range><constant>1.0</constant>
      <linear>0</linear><quadratic>0</quadratic></attenuation>
    <direction>0 0 -1</direction>
  </light>

  <!-- ================================================= -->
  <!-- GROUND  – sandy beach                             -->
  <!-- ================================================= -->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
        <material>
          <ambient>0.76 0.70 0.50 1</ambient>
          <diffuse>0.82 0.75 0.55 1</diffuse>
          <specular>0.10 0.09 0.07 1</specular>
        </material>
      </visual>
    </link>
  </model>

  <!-- ================================================= -->
  <!-- OCEAN PLANE                                       -->
  <!-- ================================================= -->
  <model name="ocean_plane">
    <static>true</static>
    <pose>0 -42 -0.05 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry><plane><normal>0 0 1</normal><size>100 20</size></plane></geometry>
        <material>
          <ambient>0.04 0.22 0.50 0.88</ambient>
          <diffuse>0.05 0.28 0.60 0.88</diffuse>
          <specular>0.50 0.50 0.50 1</specular>
        </material>
      </visual>
    </link>
  </model>

  <!-- ================================================= -->
  <!-- BOUNDARY WALLS                                    -->
  <!-- ================================================= -->
  <model name="boundary_wall_north">
    <static>true</static><pose>0 32 1.5 0 0 0</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>66 0.5 3.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>66 0.5 3.0</size></box></geometry>
        <material><ambient>0.55 0.52 0.48 1</ambient><diffuse>0.60 0.57 0.53 1</diffuse></material></visual>
    </link>
  </model>
  <model name="boundary_wall_south">
    <static>true</static><pose>0 -32 1.5 0 0 0</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>66 0.5 3.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>66 0.5 3.0</size></box></geometry>
        <material><ambient>0.52 0.49 0.44 1</ambient><diffuse>0.57 0.54 0.49 1</diffuse></material></visual>
    </link>
  </model>
  <model name="boundary_wall_east">
    <static>true</static><pose>32 0 1.5 0 0 1.5708</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>64 0.5 3.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>64 0.5 3.0</size></box></geometry>
        <material><ambient>0.55 0.52 0.48 1</ambient><diffuse>0.60 0.57 0.53 1</diffuse></material></visual>
    </link>
  </model>
  <model name="boundary_wall_west">
    <static>true</static><pose>-32 0 1.5 0 0 1.5708</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>64 0.5 3.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>64 0.5 3.0</size></box></geometry>
        <material><ambient>0.55 0.52 0.48 1</ambient><diffuse>0.60 0.57 0.53 1</diffuse></material></visual>
    </link>
  </model>

  <!-- ================================================= -->
  <!-- SEAWALL / BREAKWATER                              -->
  <!-- ================================================= -->
  <model name="seawall_segment_1">
    <static>true</static><pose>-10 -18 1.0 0 0 0</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>12 0.6 2.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>12 0.6 2.0</size></box></geometry>
        <material><ambient>0.50 0.47 0.43 1</ambient><diffuse>0.55 0.52 0.48 1</diffuse></material></visual>
    </link>
  </model>
  <model name="seawall_segment_2">
    <static>true</static><pose>8 -18 1.0 0 0 0</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>10 0.6 2.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 0.6 2.0</size></box></geometry>
        <material><ambient>0.50 0.47 0.43 1</ambient><diffuse>0.55 0.52 0.48 1</diffuse></material></visual>
    </link>
  </model>

  <!-- ================================================= -->
  <!-- COLLAPSED BUILDING RUINS                          -->
  <!-- ================================================= -->
  <model name="ruin_wall_1"><static>true</static><pose>18 20 1.2 0 0 0</pose>
    <link name="link"><collision name="c"><geometry><box><size>10 0.4 2.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 0.4 2.4</size></box></geometry>
        <material><ambient>0.56 0.53 0.49 1</ambient><diffuse>0.61 0.58 0.54 1</diffuse></material></visual></link>
  </model>
  <model name="ruin_wall_2"><static>true</static><pose>23 15 1.2 0 0 1.5708</pose>
    <link name="link"><collision name="c"><geometry><box><size>10 0.4 2.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 0.4 2.4</size></box></geometry>
        <material><ambient>0.54 0.51 0.47 1</ambient><diffuse>0.59 0.56 0.52 1</diffuse></material></visual></link>
  </model>
  <model name="ruin_wall_3"><static>true</static><pose>14 12 0.8 0 0.15 0.3</pose>
    <link name="link"><collision name="c"><geometry><box><size>8 0.4 1.6</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8 0.4 1.6</size></box></geometry>
        <material><ambient>0.55 0.52 0.48 1</ambient><diffuse>0.60 0.57 0.53 1</diffuse></material></visual></link>
  </model>
  <model name="ruin_wall_4"><static>true</static><pose>20 10 0.7 0 -0.1 1.5708</pose>
    <link name="link"><collision name="c"><geometry><box><size>6 0.4 1.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 0.4 1.4</size></box></geometry>
        <material><ambient>0.53 0.50 0.46 1</ambient><diffuse>0.58 0.55 0.51 1</diffuse></material></visual></link>
  </model>
  <model name="ruin_roof_slab"><static>true</static><pose>19 18 1.0 0.6 0 0</pose>
    <link name="link"><collision name="c"><geometry><box><size>5 4 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5 4 0.3</size></box></geometry>
        <material><ambient>0.52 0.49 0.45 1</ambient><diffuse>0.57 0.54 0.50 1</diffuse></material></visual></link>
  </model>

  <!-- ================================================= -->
  <!-- INLINE ROCK CLUSTERS                              -->
  <!--                                                   -->
  <!-- Each "rock" is a static model made of 2-3 tilted  -->
  <!-- box/sphere sub-links that together look like a    -->
  <!-- natural irregular boulder. Colours sampled from   -->
  <!-- real granite/sandstone photogrammetry references. -->
  <!-- ================================================= -->

  <!-- === LARGE BOULDERS === -->

  <!-- Boulder A  (-6, 4)  grey granite -->
  <model name="boulder_A"><static>true</static><pose>-6 4 0 0 0 0.5</pose>
    <link name="base"><pose>0 0 0.55 0.15 0.10 0</pose>
      <collision name="c"><geometry><box><size>2.5 1.8 1.10</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2.5 1.8 1.10</size></box></geometry>
        <material><ambient>0.38 0.35 0.32 1</ambient><diffuse>0.43 0.40 0.37 1</diffuse><specular>0.06 0.06 0.06 1</specular></material></visual>
    </link>
    <link name="cap"><pose>0.3 -0.2 1.2 -0.2 0.15 0.4</pose>
      <collision name="c"><geometry><box><size>1.6 1.2 0.7</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.6 1.2 0.7</size></box></geometry>
        <material><ambient>0.35 0.33 0.30 1</ambient><diffuse>0.40 0.38 0.35 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
    </link>
  </model>

  <!-- Boulder B  (12, 2)  dark basalt -->
  <model name="boulder_B"><static>true</static><pose>12 2 0 0 0 1.1</pose>
    <link name="base"><pose>0 0 0.7 -0.10 0.20 0</pose>
      <collision name="c"><geometry><box><size>3.0 2.0 1.40</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3.0 2.0 1.40</size></box></geometry>
        <material><ambient>0.28 0.26 0.24 1</ambient><diffuse>0.33 0.31 0.29 1</diffuse><specular>0.08 0.08 0.08 1</specular></material></visual>
    </link>
    <link name="cap"><pose>-0.4 0.3 1.5 0.25 -0.10 0.6</pose>
      <collision name="c"><geometry><box><size>1.8 1.5 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.8 1.5 0.8</size></box></geometry>
        <material><ambient>0.30 0.28 0.25 1</ambient><diffuse>0.35 0.33 0.30 1</diffuse><specular>0.07 0.07 0.07 1</specular></material></visual>
    </link>
  </model>

  <!-- Boulder C  (-22, 8)  sandstone tan -->
  <model name="boulder_C"><static>true</static><pose>-22 8 0 0 0 0.8</pose>
    <link name="base"><pose>0 0 0.45 0.12 -0.08 0</pose>
      <collision name="c"><geometry><box><size>2.8 1.8 0.90</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2.8 1.8 0.90</size></box></geometry>
        <material><ambient>0.55 0.46 0.35 1</ambient><diffuse>0.60 0.51 0.40 1</diffuse><specular>0.04 0.04 0.03 1</specular></material></visual>
    </link>
    <link name="side"><pose>0.8 0.5 0.9 0.3 0.2 1.0</pose>
      <collision name="c"><geometry><box><size>1.4 1.0 0.7</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.4 1.0 0.7</size></box></geometry>
        <material><ambient>0.52 0.44 0.33 1</ambient><diffuse>0.57 0.49 0.38 1</diffuse><specular>0.04 0.04 0.03 1</specular></material></visual>
    </link>
  </model>

  <!-- Boulder D  (3, -10)  grey-green schist -->
  <model name="boulder_D"><static>true</static><pose>3 -10 0 0 0 2.0</pose>
    <link name="base"><pose>0 0 0.60 0.08 0.28 0</pose>
      <collision name="c"><geometry><box><size>2.2 1.6 1.20</size></box></geometry></collision>
